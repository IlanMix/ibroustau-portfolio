---
import Layout from '../layouts/Layout.astro';
import { veille } from '../data/veille.js';

const formater = (iso) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout titre="Veille technologique">
  <h1 class="page-titre">Veille technologique</h1>

  <section>
    <h2>Sujet et question de veille</h2>
    <p><strong>Sujet.</strong> {veille.theme}</p>
    <p>{veille.problematique}</p>
  </section>

  <section>
    <h2>Pourquoi ce sujet ?</h2>
    <p>{veille.motivation}</p>
  </section>

  <section>
    <h2>Méthode</h2>
    <ul class="etiquettes">
      {veille.outils.map((o) => <li>{o}</li>)}
    </ul>
    <p>{veille.methode}</p>
  </section>

  <section>
    <h2>Ce que j’en retiens</h2>
    <ul class="liste-simple">
      {veille.enseignements.map((enseignement) => <li>{enseignement}</li>)}
    </ul>
  </section>

  <section>
    <h2>Actualités suivies</h2>
    {veille.articles.map((a) => (
      <article class="entree">
        <p class="entree-date"><time datetime={a.date}>{formater(a.date)}</time></p>
        <div>
          <h3><a href={a.url} target="_blank" rel="noopener noreferrer">{a.titre}</a></h3>
          <p class="entree-lieu">{a.source}</p>
          <p>{a.resume}</p>
        </div>
      </article>
    ))}
  </section>
</Layout>
