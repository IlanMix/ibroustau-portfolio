---
import Layout from '../layouts/Layout.astro';
import { profil } from '../data/profil.js';
import {
  contact,
  presentation,
  formations,
  experiences,
  langues,
  competences,
  savoirEtre,
  centresInteret,
} from '../data/cv.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fichierCv = `${base}/cv-ilan.pdf`;
---
<Layout titre="CV">
  <h1 class="page-titre">CV</h1>
  <div class="cv-actions chapeau">
    <a class="bouton" href={fichierCv} target="_blank" rel="noopener noreferrer">Visualiser mon CV (PDF)</a>
    <a class="bouton" href={fichierCv} download>Télécharger mon CV (PDF)</a>
  </div>

  <section>
    <h2>Profil</h2>
    <p>{presentation}</p>
  </section>

  <section>
    <h2>Contact</h2>
    <ul class="liste-simple">
      <li><a href={`mailto:${profil.email}`}>{profil.email}</a></li>
      <li><a href={`tel:${contact.telephone.replace(/\s/g, '')}`}>{contact.telephone}</a></li>
    </ul>
  </section>

  <section>
    <h2>Formation</h2>
    {formations.map((f) => (
      <article class="entree">
        <p class="entree-date">{f.periode}</p>
        <div>
          <h3>{f.intitule}</h3>
          <p class="entree-lieu">{f.lieu}</p>
          {f.detail && <p>{f.detail}</p>}
        </div>
      </article>
    ))}
  </section>

  <section>
    <h2>Expériences</h2>
    {experiences.map((e) => (
      <article class="entree">
        <p class="entree-date">{e.periode}</p>
        <div>
          <h3>{e.intitule}</h3>
          <p class="entree-lieu">{e.lieu}</p>
          {e.detail && <p>{e.detail}</p>}
        </div>
      </article>
    ))}
  </section>

  <section>
    <h2>Langues</h2>
    <ul class="liste-simple">
      {langues.map((l) => <li><strong>{l.nom}</strong> : {l.niveau}</li>)}
    </ul>
  </section>

  <section>
    <h2>Compétences</h2>
    {competences.map((g) => (
      <div class="cv-competence">
        <h3>{g.domaine}</h3>
        <ul class="etiquettes">
          {g.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Savoir-être</h2>
    <ul class="etiquettes">
      {savoirEtre.map((competence) => <li>{competence}</li>)}
    </ul>
  </section>

  <section>
    <h2>Centres d’intérêt</h2>
    <ul class="liste-simple">
      {centresInteret.map((interet) => <li>{interet}</li>)}
    </ul>
  </section>
</Layout>
